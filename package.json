{
  "name": "ixo-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "add-oracle": "bun scripts/add-oracle.ts",
    "add-plugin": "bun scripts/add-plugin.ts",
    "regenerate": "bun scripts/regenerate.ts",
    "catalog": "bun scripts/catalog.ts",
    "check": "bun scripts/check-schemas.ts",
    "validate": "claude plugin validate . --strict && for p in plugins/*/; do claude plugin validate \"$p\" --strict || exit 1; done"
  },
  "devDependencies": {
    "ajv": "8.17.1"
  }
}
