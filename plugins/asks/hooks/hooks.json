{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-update.mjs\" >/dev/null 2>&1; exit 0",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
